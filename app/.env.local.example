# Copy to app/.env.local and fill from:
#   npx firebase-tools apps:sdkconfig WEB --project ai-expense-tracker-navya
#
# These are not secrets - a Firebase web config ships to the browser by design.
# Per-user isolation comes from Firestore security rules. .env.local is
# gitignored anyway, to keep environments separable.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ai-expense-tracker-navya.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-expense-tracker-navya
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=175631461008
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=https://expense-api-175631461008.asia-south1.run.app
