# dependencies — anywhere in the tree, not just server/
node_modules/
.npm-cache/

# build output
dist/

# local env / secrets — never commit these
.env
.env.local
.env.*.local

# the old SQLite practice database
server/data.db
*.db-shm
*.db-wal

# firebase tooling
.firebase/
firebase-debug.log
firestore-debug.log

# local editor / tooling config
.claude/

# python bytecode — build artefacts, and they were being committed
__pycache__/
*.py[cod]
.venv/
venv/
